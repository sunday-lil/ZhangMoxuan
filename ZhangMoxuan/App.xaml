<Application x:Class="ZhangMoxuan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ===== 550W / MOSS 控制台主题 =====
                 依据《流浪地球2》制作手记的 UI 规范：
                 中文字体 思源黑体；英文字体 Rajdhani；整体深灰色系；
                 红 / 中黄 / 亮白作为跳色；边框避免斜线构成。 -->

            <Color x:Key="BgBlack">#121212</Color>
            <Color x:Key="BgPanel">#1A1A1A</Color>
            <Color x:Key="BgElevated">#232323</Color>
            <Color x:Key="BgHeader">#2A2A2A</Color>
            <Color x:Key="GridLine">#3A3A3A</Color>
            <Color x:Key="GridLineBright">#5A5A5A</Color>

            <Color x:Key="MossRed">#C93A3A</Color>
            <Color x:Key="MossRedBright">#F04A4A</Color>
            <Color x:Key="MossRedDim">#5A2323</Color>
            <Color x:Key="MossRedMute">#8A3A3A</Color>

            <Color x:Key="WarnAmber">#D6A23A</Color>
            <Color x:Key="AmberBright">#F0C05A</Color>
            <Color x:Key="AmberDim">#6B5124</Color>
            <Color x:Key="SignalGreen">#7FA650</Color>
            <Color x:Key="Steel">#8A8A8A</Color>

            <Color x:Key="TextPrimary">#F2F2F2</Color>
            <Color x:Key="TextSecondary">#BDBDBD</Color>
            <Color x:Key="TextTertiary">#808080</Color>

            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgBlack}"/>
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource BgPanel}"/>
            <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource BgElevated}"/>
            <SolidColorBrush x:Key="HeaderBrush" Color="{StaticResource BgHeader}"/>
            <SolidColorBrush x:Key="GridBrush" Color="{StaticResource GridLine}"/>
            <SolidColorBrush x:Key="GridBrightBrush" Color="{StaticResource GridLineBright}"/>
            <SolidColorBrush x:Key="RedBrush" Color="{StaticResource MossRed}"/>
            <SolidColorBrush x:Key="RedBrightBrush" Color="{StaticResource MossRedBright}"/>
            <SolidColorBrush x:Key="RedDimBrush" Color="{StaticResource MossRedDim}"/>
            <SolidColorBrush x:Key="RedMuteBrush" Color="{StaticResource MossRedMute}"/>
            <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource WarnAmber}"/>
            <SolidColorBrush x:Key="AmberBrightBrush" Color="{StaticResource AmberBright}"/>
            <SolidColorBrush x:Key="AmberDimBrush" Color="{StaticResource AmberDim}"/>
            <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource SignalGreen}"/>
            <SolidColorBrush x:Key="SteelBrush" Color="{StaticResource Steel}"/>
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextSecondary}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>
            <!-- 兼容旧引用 -->
            <SolidColorBrush x:Key="TextWhiteBrush" Color="{StaticResource TextPrimary}"/>

            <!-- 字体：中文用系统可用的思源黑体替代（微软雅黑），英文/数字用 Rajdhani -->
            <FontFamily x:Key="SansFont">Microsoft YaHei UI, Segoe UI</FontFamily>
            <FontFamily x:Key="CondensedFont">pack://application:,,,/Assets/Fonts/#Rajdhani</FontFamily>
            <FontFamily x:Key="DisplayFont">pack://application:,,,/Assets/Fonts/#Rajdhani</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

            <Style x:Key="MossText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            </Style>

            <Style x:Key="HudLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource CondensedFont}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
            </Style>

            <Style x:Key="HudValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource CondensedFont}"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="Medium"/>
            </Style>

            <Style x:Key="PanelCode" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource AmberBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource CondensedFont}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
            </Style>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BgBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
