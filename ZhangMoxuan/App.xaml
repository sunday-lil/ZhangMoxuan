<Application x:Class="ZhangMoxuan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ===== MOSS 主题：深邃蓝黑 + 克制赤红 =====
                 去廉价霓虹感：背景加入轻微蓝调增加层次，红色降饱和并分级使用 -->

            <!-- 背景层级 -->
            <Color x:Key="BgBlack">#0A0E14</Color>      <!-- 主背景：深蓝黑，非纯黑 -->
            <Color x:Key="BgPanel">#11161F</Color>       <!-- 面板：略亮，与背景拉开层次 -->
            <Color x:Key="BgElevated">#161C27</Color>    <!-- 更上层（悬浮/选中） -->
            <Color x:Key="GridLine">#1E2530</Color>      <!-- 网格线：低对比，不抢眼 -->

            <!-- 红色系（MOSS 标识色，分级使用） -->
            <Color x:Key="MossRed">#D8434C</Color>       <!-- 主红：降饱和，更高级 -->
            <Color x:Key="MossRedBright">#F2555E</Color> <!-- 亮红：仅用于关键高亮 -->
            <Color x:Key="MossRedDim">#6B2B33</Color>    <!-- 暗红：背景/底纹 -->
            <Color x:Key="MossRedMute">#8A3A42</Color>   <!-- 次要红：副标签 -->

            <!-- 辅助色 -->
            <Color x:Key="HumanBlue">#3A7BFF</Color>     <!-- 人类蓝：少量对比 -->
            <Color x:Key="WarnAmber">#E8A53A</Color>     <!-- 警示琥珀 -->

            <!-- 文字层级 -->
            <Color x:Key="TextPrimary">#DDE2EA</Color>   <!-- 主要文字 -->
            <Color x:Key="TextSecondary">#8A929E</Color> <!-- 次要文字 -->
            <Color x:Key="TextTertiary">#5A6370</Color>  <!-- 三级文字/占位 -->

            <!-- 笔刷 -->
            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgBlack}"/>
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource BgPanel}"/>
            <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource BgElevated}"/>
            <SolidColorBrush x:Key="GridBrush" Color="{StaticResource GridLine}"/>
            <SolidColorBrush x:Key="RedBrush" Color="{StaticResource MossRed}"/>
            <SolidColorBrush x:Key="RedBrightBrush" Color="{StaticResource MossRedBright}"/>
            <SolidColorBrush x:Key="RedDimBrush" Color="{StaticResource MossRedDim}"/>
            <SolidColorBrush x:Key="RedMuteBrush" Color="{StaticResource MossRedMute}"/>
            <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource HumanBlue}"/>
            <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource WarnAmber}"/>
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextSecondary}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiary}"/>
            <!-- 兼容旧引用 -->
            <SolidColorBrush x:Key="TextWhiteBrush" Color="{StaticResource TextPrimary}"/>

            <!-- 字体：UI 用现代无衬线，数据/代码用等宽 -->
            <FontFamily x:Key="SansFont">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>
            <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI</FontFamily>

            <!-- 全局控件样式 -->
            <Style x:Key="MossText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            </Style>

            <Style x:Key="HudLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
            </Style>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BgBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
