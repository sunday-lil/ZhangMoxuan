<UserControl x:Class="ZhangMoxuan.Controls.DigitalLifeCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             Height="180">
    <UserControl.Resources>
        <!-- 头像脉冲：ScaleTransform + Opacity 双驱动 -->
        <Storyboard x:Key="AvatarPulse">
            <DoubleAnimation Storyboard.TargetName="AvatarScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="0.92" To="1.08" Duration="0:0:1.6"
                             AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="AvatarScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="0.92" To="1.08" Duration="0:0:1.6"
                             AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="AvatarCore"
                             Storyboard.TargetProperty="Opacity"
                             From="0.62" To="1.0" Duration="0:0:1.6"
                             AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
        <!-- 550W 接入指示灯：上传时闪烁 -->
        <Storyboard x:Key="AccessBlink">
            <DoubleAnimation Storyboard.TargetName="AccessLight"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.15" Duration="0:0:0.45"
                             AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
    </UserControl.Resources>

    <Border x:Name="CardBorder"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource GridBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="16">
        <Border.Effect>
            <DropShadowEffect x:Name="CardGlow"
                              Color="#D8434C" BlurRadius="10"
                              ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 主内容区 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：数字意识头像 -->
                <Grid Grid.Column="0"
                      Width="100" Height="100"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 外环 -->
                    <Ellipse x:Name="AvatarRing"
                             Stroke="{StaticResource RedDimBrush}" StrokeThickness="1"/>
                    <!-- 内环 -->
                    <Ellipse x:Name="AvatarRing2"
                             Stroke="{StaticResource RedBrush}" StrokeThickness="0.6"
                             Opacity="0.6" Margin="6"/>
                    <!-- 意识核心（渐变圆 + 脉冲） -->
                    <Ellipse x:Name="AvatarCore" Margin="14" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Fill>
                            <RadialGradientBrush GradientOrigin="0.5,0.4"
                                                 Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop x:Name="AvatarStop0" Color="#FFF2555E" Offset="0"/>
                                <GradientStop x:Name="AvatarStop1" Color="#8AD8434C" Offset="0.6"/>
                                <GradientStop x:Name="AvatarStop2" Color="#400A0A0E" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                        <Ellipse.Effect>
                            <DropShadowEffect x:Name="AvatarGlow"
                                              Color="#D8434C" BlurRadius="14"
                                              ShadowDepth="0" Opacity="0.6"/>
                        </Ellipse.Effect>
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="AvatarScale"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <!-- 右侧：信息区 -->
                <Grid Grid.Column="1" Margin="14,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部：姓名 + 数字生命ID -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock x:Name="NameText" Text="图丫丫"
                                   Foreground="{StaticResource TextWhiteBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="18" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="IdText" Text="DLID-550W-0001"
                                   Foreground="{StaticResource RedBrightBrush}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="10,3,0,0"/>
                    </StackPanel>

                    <!-- 中部：生命体征数据 -->
                    <UniformGrid Grid.Row="1" Columns="2" Rows="2" Margin="0,8,0,6">
                        <StackPanel Margin="0,0,8,2">
                            <TextBlock Text="迭代次数"
                                       Foreground="{StaticResource TextBrush}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10"/>
                            <TextBlock x:Name="IterText" Text="0"
                                       Foreground="{StaticResource TextWhiteBrush}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,2">
                            <TextBlock Text="意识稳定度"
                                       Foreground="{StaticResource TextBrush}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10"/>
                            <TextBlock x:Name="StabilityText" Text="0.00%"
                                       Foreground="{StaticResource TextWhiteBrush}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="记忆完整度"
                                       Foreground="{StaticResource TextBrush}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10"/>
                            <TextBlock x:Name="MemoryText" Text="0.00%"
                                       Foreground="{StaticResource TextWhiteBrush}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="寿命剩余"
                                       Foreground="{StaticResource TextBrush}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10"/>
                            <TextBlock x:Name="LifespanText" Text="00:00:00"
                                       Foreground="{StaticResource TextWhiteBrush}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="13"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- 底部：状态标签 + 550W 接入指示灯 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="[" Foreground="{StaticResource RedBrush}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                        <TextBlock x:Name="StatusText" Text="ACTIVE"
                                   Foreground="{StaticResource RedBrightBrush}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   FontWeight="Bold"/>
                        <TextBlock Text="]" Foreground="{StaticResource RedBrush}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                        <TextBlock Text="·" Foreground="{StaticResource TextBrush}"
                                   Margin="8,0,8,0"
                                   FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                        <TextBlock Text="550W LINK"
                                   Foreground="{StaticResource TextBrush}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <Ellipse x:Name="AccessLight" Width="8" Height="8"
                                 Margin="6,0,0,1" Fill="{StaticResource RedBrush}">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#D8434C" BlurRadius="6"
                                                  ShadowDepth="0" Opacity="0.6"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 底部：意识上传进度条 -->
            <Border Grid.Row="1" Height="4" CornerRadius="2"
                    Background="{StaticResource GridBrush}"
                    Margin="0,10,0,0" HorizontalAlignment="Stretch">
                <Border x:Name="ProgressFill" CornerRadius="2"
                        HorizontalAlignment="Stretch"
                        Background="{StaticResource RedBrush}">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ProgressScale" ScaleX="0" CenterX="0"/>
                    </Border.RenderTransform>
                </Border>
            </Border>
        </Grid>
    </Border>
</UserControl>
