<UserControl x:Class="ZhangMoxuan.Controls.HandshakeProtocol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="StepsPanel" Grid.Row="0" Margin="10,8"/>

        <Border Grid.Row="1" Background="#181818" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Padding="10,6">
            <Grid>
                <TextBlock Text="OVERALL // 总进度" FontFamily="{StaticResource CondensedFont}" FontSize="8"
                           Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Grid x:Name="OverallHost" Width="180" Height="4" VerticalAlignment="Center"/>
                    <TextBlock x:Name="OverallText" Text=" 0%" Margin="8,0,0,0" FontFamily="{StaticResource CondensedFont}"
                               FontSize="9" Foreground="{StaticResource RedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
