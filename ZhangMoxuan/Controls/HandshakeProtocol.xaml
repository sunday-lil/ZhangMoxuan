<UserControl x:Class="ZhangMoxuan.Controls.HandshakeProtocol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标签栏 -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GridBrush}" BorderThickness="0,0,0,1" Padding="16,8">
            <TextBlock Text="Protocol Handshake · 550W → UEG Network"
                       FontFamily="{StaticResource SansFont}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Typography.Capitals="AllSmallCaps"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- 握手步骤列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent">
            <StackPanel x:Name="StepsPanel" Margin="10,8"/>
        </ScrollViewer>

        <!-- 底部整体进度 -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GridBrush}" BorderThickness="0,1,0,0" Padding="16,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="OVERALL " FontFamily="{StaticResource SansFont}" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Typography.Capitals="AllSmallCaps"/>
                <Grid x:Name="OverallHost" Width="180" Height="4" VerticalAlignment="Center"/>
                <TextBlock x:Name="OverallText" Text=" 0%" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource RedBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
