<UserControl x:Class="ZhangMoxuan.Controls.HandshakeProtocol"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             Background="#050608">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标签栏 -->
        <Border Grid.Row="0" Background="#0A0C10" BorderBrush="#1A1F26" BorderThickness="0,0,0,1" Padding="12,6">
            <TextBlock Text="PROTOCOL HANDSHAKE // 550W → UEG NETWORK"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="12"
                       Foreground="#FF1A1A"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- 握手步骤列表 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#050608">
            <StackPanel x:Name="StepsPanel" Margin="10,8"/>
        </ScrollViewer>

        <!-- 底部整体进度 -->
        <Border Grid.Row="2" Background="#0A0C10" BorderBrush="#1A1F26" BorderThickness="0,1,0,0" Padding="12,6">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="OVERALL " FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#9AA0A6" VerticalAlignment="Center"/>
                <Grid x:Name="OverallHost" Width="180" Height="6" VerticalAlignment="Center"/>
                <TextBlock x:Name="OverallText" Text=" 0%" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#FF1A1A" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
