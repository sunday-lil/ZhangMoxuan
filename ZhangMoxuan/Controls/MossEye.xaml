<UserControl x:Class="ZhangMoxuan.Controls.MossEye"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Viewbox Stretch="Uniform">
        <Canvas Width="300" Height="300">
            <!-- 550W 光学传感器外壳：白色/灰色金属，黑色镜筒，红色虹膜 -->
            <Border Canvas.Left="14" Canvas.Top="14" Width="272" Height="272" CornerRadius="14"
                    BorderBrush="#4A4A4A" BorderThickness="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#E6E6E6" Offset="0"/>
                        <GradientStop Color="#B8B8B8" Offset="0.42"/>
                        <GradientStop Color="#7E7E7E" Offset="0.78"/>
                        <GradientStop Color="#5A5A5A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- 外壳分缝与散热槽 -->
            <Rectangle Canvas.Left="20" Canvas.Top="48" Width="260" Height="1" Fill="#7A7A7A" Opacity="0.8"/>
            <Rectangle Canvas.Left="20" Canvas.Top="252" Width="260" Height="1" Fill="#4A4A4A" Opacity="0.8"/>
            <Rectangle Canvas.Left="28" Canvas.Top="262" Width="60" Height="1" Fill="#3E3E3E"/>
            <Rectangle Canvas.Left="28" Canvas.Top="267" Width="60" Height="1" Fill="#3E3E3E"/>
            <Rectangle Canvas.Left="28" Canvas.Top="272" Width="60" Height="1" Fill="#3E3E3E"/>

            <!-- 四角固定螺栓 -->
            <Ellipse Canvas.Left="28" Canvas.Top="28" Width="8" Height="8" Fill="#4A4A4A" Stroke="#2A2A2A" StrokeThickness="1"/>
            <Ellipse Canvas.Left="264" Canvas.Top="28" Width="8" Height="8" Fill="#4A4A4A" Stroke="#2A2A2A" StrokeThickness="1"/>
            <Ellipse Canvas.Left="28" Canvas.Top="264" Width="8" Height="8" Fill="#4A4A4A" Stroke="#2A2A2A" StrokeThickness="1"/>
            <Ellipse Canvas.Left="264" Canvas.Top="264" Width="8" Height="8" Fill="#4A4A4A" Stroke="#2A2A2A" StrokeThickness="1"/>

            <!-- 内嵌黑色面板 -->
            <Rectangle Canvas.Left="48" Canvas.Top="48" Width="204" Height="204" Fill="#0C0C0C" Stroke="#2E2E2E" StrokeThickness="1"/>

            <!-- 镜筒外圈 -->
            <Ellipse Canvas.Left="65" Canvas.Top="65" Width="170" Height="170" Fill="#080808" Stroke="#5A5A5A" StrokeThickness="2"/>
            <Ellipse Canvas.Left="72" Canvas.Top="72" Width="156" Height="156" Fill="#0E0E0E" Stroke="#9A9A9A" StrokeThickness="1.2"/>
            <Ellipse Canvas.Left="80" Canvas.Top="80" Width="140" Height="140" Fill="#050505" Stroke="#3A3A3A" StrokeThickness="1"/>
            <Ellipse Canvas.Left="90" Canvas.Top="90" Width="120" Height="120" Fill="#000000" Stroke="#242424" StrokeThickness="1"/>

            <!-- 镜筒刻线 -->
            <Path Stroke="#5A5A5A" StrokeThickness="0.8" Data="M150,72 L150,80 M228,150 L220,150 M150,228 L150,220 M72,150 L80,150"/>
            <Path Stroke="#6B2B33" StrokeThickness="0.8" Data="M96,96 L102,102 M204,96 L198,102 M96,204 L102,198 M204,204 L198,198"/>

            <!-- 红色虹膜 / 瞳孔 -->
            <Ellipse x:Name="Pupil" Canvas.Left="118" Canvas.Top="118" Width="64" Height="64"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.45,0.4" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#FF9A9A" Offset="0"/>
                        <GradientStop Color="#F04A4A" Offset="0.45"/>
                        <GradientStop Color="#A82626" Offset="0.82"/>
                        <GradientStop Color="#4A0F0F" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="PupilScale" CenterX="32" CenterY="32"/>
                </Ellipse.RenderTransform>
                <Ellipse.Effect>
                    <DropShadowEffect x:Name="PupilGlow" Color="#F04A4A" BlurRadius="26" ShadowDepth="0" Opacity="0.9"/>
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Canvas.Left="132" Canvas.Top="132" Width="36" Height="36" Fill="#120202" Opacity="0.72"/>
            <Ellipse Canvas.Left="132" Canvas.Top="132" Width="10" Height="10" Fill="#FFDCDC" Opacity="0.55"/>

            <!-- 状态灯 -->
            <Rectangle Canvas.Left="66" Canvas.Top="56" Width="8" Height="8" Fill="#F04A4A">
                <Rectangle.Effect>
                    <DropShadowEffect Color="#F04A4A" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                </Rectangle.Effect>
            </Rectangle>
            <TextBlock Canvas.Left="80" Canvas.Top="54" Text="OPTICAL" FontFamily="{StaticResource CondensedFont}"
                       FontSize="7" Foreground="#3A3A3A"/>

            <TextBlock Canvas.Left="188" Canvas.Top="54" Text="550W" FontFamily="{StaticResource CondensedFont}"
                       FontSize="10" FontWeight="Bold" Foreground="#3A3A3A"/>

            <!-- 外壳铭牌 -->
            <TextBlock Canvas.Left="66" Canvas.Top="262" Text="MOSS // 550W" FontFamily="{StaticResource CondensedFont}"
                       FontSize="9" FontWeight="SemiBold" Foreground="#2E2E2E"/>
            <TextBlock Canvas.Left="196" Canvas.Top="262" Text="SN 550W-8192" FontFamily="{StaticResource CondensedFont}"
                       FontSize="8" Foreground="#3A3A3A"/>
        </Canvas>
    </Viewbox>
</UserControl>
