<UserControl x:Class="ZhangMoxuan.Controls.NetworkTopology"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <Canvas x:Name="RadarCanvas" Grid.Row="0" ClipToBounds="True" Background="#101010"/>

        <Border Grid.Row="1" Background="#181818" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RANGE 80 KM" FontFamily="{StaticResource CondensedFont}" FontSize="8"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,16,0"/>
                    <TextBlock Text="SWEEP 12 RPM" FontFamily="{StaticResource CondensedFont}" FontSize="8"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,16,0"/>
                    <TextBlock Text="MODE // AIR &amp; ORBITAL" FontFamily="{StaticResource CondensedFont}" FontSize="8"
                               Foreground="{StaticResource TextTertiaryBrush}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                        <TextBlock Text="ONLINE " FontFamily="{StaticResource CondensedFont}" FontSize="8" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="NodesStat" Text="17/17" FontFamily="{StaticResource CondensedFont}" FontSize="9" Foreground="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                        <TextBlock Text="BW " FontFamily="{StaticResource CondensedFont}" FontSize="8" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BandwidthStat" Text="505 Tbps" FontFamily="{StaticResource CondensedFont}" FontSize="9" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LAT " FontFamily="{StaticResource CondensedFont}" FontSize="8" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LatencyStat" Text="21 ms" FontFamily="{StaticResource CondensedFont}" FontSize="9" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
