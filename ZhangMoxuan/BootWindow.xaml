<Window x:Class="ZhangMoxuan.BootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ZhangMoxuan.Controls"
        Title="550W" Height="720" Width="1280"
        WindowStyle="None" WindowState="Maximized"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Cursor="None">
    <Grid>
        <!-- 全局扫描线（更柔和） -->
        <Rectangle x:Name="ScanLine" Height="1" VerticalAlignment="Top" Fill="{StaticResource RedBrush}" Opacity="0.18">
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="ScanLineT" Y="0"/>
            </Rectangle.RenderTransform>
        </Rectangle>

        <!-- 顶部标识 -->
        <Grid VerticalAlignment="Top" Height="52">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="40,0,0,0">
                <TextBlock Text="550W" FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="  ·  SMART QUANTUM COMPUTER" FontFamily="{StaticResource SansFont}" FontSize="10"
                           Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3"
                           Typography.Capitals="AllSmallCaps"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,40,0">
                <TextBlock x:Name="StageLabel" Text="Stage 1 of 4 · Firmware" FontFamily="{StaticResource SansFont}"
                           FontSize="11" Foreground="{StaticResource RedBrush}" Margin="0,0,20,0" Typography.Capitals="AllSmallCaps"/>
                <TextBlock x:Name="BootClock" Text="2075-01-01 00:00:00" FontFamily="{StaticResource MonoFont}"
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Grid>

        <!-- 阶段1: 固件加载 -->
        <Grid x:Name="StageFirmware" Margin="48,84,48,80" Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧: 自检日志流 -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GridBrush}" BorderThickness="1" Margin="0,0,12,0">
                <Grid>
                    <TextBlock Text="POWER-ON SELF-TEST · FIRMWARE LOG" FontFamily="{StaticResource SansFont}" FontSize="10"
                               FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,14,0,0" Typography.Capitals="AllSmallCaps"/>
                    <ScrollViewer x:Name="LogScroll" Margin="16,38,16,16" VerticalScrollBarVisibility="Hidden">
                        <TextBlock x:Name="BootLog" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" LineStackingStrategy="BlockLineHeight" LineHeight="18"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右侧: 进度面板 -->
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GridBrush}" BorderThickness="1" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="SUBSYSTEM CHECK" Style="{StaticResource HudLabel}" Margin="0,0,0,14"/>
                        <StackPanel x:Name="SubsystemList"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GridBrush}" BorderThickness="1" Padding="18,14" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="OVERALL PROGRESS" FontFamily="{StaticResource SansFont}" FontSize="10"
                                       Foreground="{StaticResource TextTertiaryBrush}" Typography.Capitals="AllSmallCaps"/>
                            <TextBlock x:Name="OverallPct" Text="0%" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource RedBrush}"/>
                        </Grid>
                        <ProgressBar x:Name="OverallBar" Height="2" Background="{StaticResource GridBrush}" Foreground="{StaticResource RedBrush}" Value="0" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 阶段2: 握手协议 -->
        <Grid x:Name="StageHandshake" Margin="48,84,48,80" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GridBrush}" BorderThickness="1" Margin="0,0,12,0">
                <ctl:HandshakeProtocol x:Name="Handshake"/>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GridBrush}" BorderThickness="1" Margin="12,0,0,0">
                <ctl:NetworkTopology x:Name="NetTopology"/>
            </Border>
        </Grid>

        <!-- 阶段3: 量子核心激活 -->
        <Grid x:Name="StageQuantum" Margin="48,84,48,80" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GridBrush}" BorderThickness="1" Margin="0,0,12,0">
                <Grid>
                    <TextBlock Text="QUANTUM CORE ACTIVATION · 8192 QUBITS" FontFamily="{StaticResource SansFont}" FontSize="10"
                               FontWeight="SemiBold" Foreground="{StaticResource TextTertiaryBrush}"
                               HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,14,0,0" Typography.Capitals="AllSmallCaps"/>
                    <TextBlock x:Name="QuantumState" Text="|Ψ⟩ = α|0⟩ + β|1⟩" FontFamily="{StaticResource MonoFont}" FontSize="10"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,16,0"/>
                    <ctl:QuantumGrid Margin="16,38,16,48"/>
                    <TextBlock x:Name="QuantumLog" FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource RedBrush}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,16,16"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GridBrush}" BorderThickness="1" Margin="12,0,0,0" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="QUBIT ENTANGLEMENT" Style="{StaticResource HudLabel}" Margin="0,0,0,14"/>
                    <StackPanel x:Name="QuantumMetricList"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 阶段4: MOSS 之眼激活 -->
        <Grid x:Name="StageEye" Margin="48,84,48,80" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <ctl:MossEye x:Name="BootEye" Width="280" Height="280" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBlock x:Name="NameFlip" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,180,0,0" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Text="550W"/>
            </Grid>
            <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource GridBrush}" BorderThickness="1" Padding="18,14">
                <StackPanel>
                    <TextBlock x:Name="IdentityLog" Text="&gt; 550W READY." FontFamily="{StaticResource MonoFont}" FontSize="12"
                               Foreground="{StaticResource RedBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部状态 -->
        <Border VerticalAlignment="Bottom" Height="44" BorderBrush="{StaticResource GridBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="40,0">
                <TextBlock x:Name="BottomStatus" Text="INITIALIZING..." FontFamily="{StaticResource SansFont}" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Typography.Capitals="AllSmallCaps"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="550W · UEG" FontFamily="{StaticResource SansFont}" FontSize="10"
                               Foreground="{StaticResource TextTertiaryBrush}" Typography.Capitals="AllSmallCaps"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
