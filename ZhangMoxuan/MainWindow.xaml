<Window x:Class="ZhangMoxuan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ZhangMoxuan.Controls"
        Title="MOSS · 550W" Height="900" Width="1600"
        Icon="pack://application:,,,/Assets/moss.ico"
        WindowStyle="None" WindowState="Maximized" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 左侧模块：编号 + 英文名 + 中文名，选中反白，红色指示条只占 3px -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource CondensedFont}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root" Background="Transparent" Height="48">
                            <Rectangle x:Name="ActiveMark" Width="3" HorizontalAlignment="Left"
                                       Fill="{StaticResource RedBrush}" Opacity="0"/>
                            <Border x:Name="Bg" Background="Transparent" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1"/>
                            <ContentPresenter Margin="14,0,10,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#252525"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter TargetName="ActiveMark" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#111111"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部次级按钮 -->
        <Style x:Key="QuietBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource CondensedFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" BorderBrush="#3A3A3A" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2A2A2A"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#6A6A6A"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部状态块 -->
        <Style x:Key="TopChip" TargetType="Border">
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="#1E1E1E"/>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform" StretchDirection="Both">
    <Grid Width="1600" Height="1000">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部状态条 ===== -->
        <Border Grid.Row="0" Background="#181818" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
            <Grid Margin="18,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" BorderBrush="{StaticResource TextPrimaryBrush}" BorderThickness="1"
                            Background="#101010" Margin="0,0,12,0">
                        <TextBlock Text="UEG" FontFamily="{StaticResource CondensedFont}" FontSize="12"
                                   FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="联合政府" FontFamily="{StaticResource SansFont}" FontSize="13"
                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="  /  550W" FontFamily="{StaticResource CondensedFont}" FontSize="13"
                                       FontWeight="SemiBold" Foreground="{StaticResource RedBrush}"/>
                        </StackPanel>
                        <TextBlock Text="UNITED EARTH GOVERNMENT · SMART QUANTUM COMPUTER"
                                   FontFamily="{StaticResource CondensedFont}" FontSize="8"
                                   Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Style="{StaticResource TopChip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="SYS NOMINAL" FontFamily="{StaticResource CondensedFont}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TopChip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="QUBIT" FontFamily="{StaticResource CondensedFont}" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="8192" FontFamily="{StaticResource CondensedFont}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TopChip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="LINK" FontFamily="{StaticResource CondensedFont}" FontSize="9" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="1.2 Tbps" FontFamily="{StaticResource CondensedFont}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TopChip}" BorderBrush="{StaticResource RedDimBrush}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ALERT" FontFamily="{StaticResource CondensedFont}" FontSize="9" Foreground="{StaticResource RedBrush}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="AlertCount" Text="03" FontFamily="{StaticResource CondensedFont}" FontSize="11" Foreground="{StaticResource RedBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="TopClock" Text="2075-01-01 00:00:00" FontFamily="{StaticResource CondensedFont}"
                                   FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="SECURE CHANNEL // LEVEL 5" FontFamily="{StaticResource CondensedFont}" FontSize="8"
                                   Foreground="{StaticResource TextTertiaryBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button x:Name="CloseBtn" Content="✕" Width="30" Height="30" Style="{StaticResource QuietBtn}"
                            FontFamily="{StaticResource SansFont}" FontSize="11" Click="CloseBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 主体 ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="312"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧模块导航 -->
            <Grid Grid.Column="0" Background="#161616">
                <Grid.RowDefinitions>
                    <RowDefinition Height="96"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="16,16,16,0">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="10" Height="10" Fill="{StaticResource RedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="MOSS" FontFamily="{StaticResource CondensedFont}" FontSize="28"
                                   FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="28"/>
                    </StackPanel>
                    <TextBlock Text="550W / SYSTEM CONSOLE" FontFamily="{StaticResource CondensedFont}" FontSize="9"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="18,0,0,0"/>
                    <Border BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Margin="0,12,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                    <TextBlock Text="MODULES // 模块" Style="{StaticResource HudLabel}" Margin="14,0,0,8"/>
                    <Button x:Name="NavDashboard" Style="{StaticResource NavBtn}" Tag="Active" Click="Nav_Click"/>
                    <Button x:Name="NavNetwork" Style="{StaticResource NavBtn}" Click="Nav_Click"/>
                    <Button x:Name="NavDigital" Style="{StaticResource NavBtn}" Click="Nav_Click"/>
                    <Button x:Name="NavCrisis" Style="{StaticResource NavBtn}" Click="Nav_Click"/>
                    <Button x:Name="NavKey" Style="{StaticResource NavBtn}" Click="Nav_Click"/>
                    <Button x:Name="NavDialog" Style="{StaticResource NavBtn}" Click="Nav_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="14,0,14,12">
                    <Border BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SysStatus" Text="ONLINE" FontFamily="{StaticResource CondensedFont}" FontSize="9"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="7,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="UEG // BEIJING NODE" FontFamily="{StaticResource CondensedFont}" FontSize="8"
                                       Foreground="{StaticResource TextTertiaryBrush}" Margin="13,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="VersionText" Text="v2.0.0" FontFamily="{StaticResource CondensedFont}" FontSize="9"
                               Foreground="{StaticResource TextTertiaryBrush}"/>
                    <TextBlock Text="CTRL + 1…6  SWITCH MODULE" FontFamily="{StaticResource CondensedFont}" FontSize="8"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 中央工作区 -->
            <Grid Grid.Column="1" Background="{StaticResource BgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Background="#181818">
                    <Grid Margin="14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border BorderBrush="{StaticResource AmberBrush}" BorderThickness="1" Padding="6,3" Margin="0,0,10,0">
                                <TextBlock x:Name="PageCode" Text="MON-01" Style="{StaticResource PanelCode}"/>
                            </Border>
                            <TextBlock x:Name="PageTitle" Text="MONITOR" FontFamily="{StaticResource CondensedFont}"
                                       FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PageSub" Text="  /  监控中心" FontFamily="{StaticResource SansFont}"
                                       FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="2,2,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="PageMeta" Text="SECTOR 07 · UEG COMMAND" FontFamily="{StaticResource CondensedFont}"
                                       FontSize="9" Foreground="{StaticResource TextTertiaryBrush}"/>
                            <Rectangle Width="6" Height="6" Fill="{StaticResource RedBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" x:Name="PageHost" Margin="12,10,12,8"/>

                <Border Grid.Row="2" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Background="#181818">
                    <Grid Margin="14,0">
                        <TextBlock x:Name="BottomStatus" Text="MOSS // 延续人类文明的最优选择"
                                   FontFamily="{StaticResource CondensedFont}" FontSize="9"
                                   Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="LoadCpu" Text="CPU 12%" FontFamily="{StaticResource CondensedFont}" FontSize="9"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,18,0"/>
                            <TextBlock x:Name="LoadQubit" Text="QUBIT 8192/8192" FontFamily="{StaticResource CondensedFont}" FontSize="9"
                                       Foreground="{StaticResource RedBrush}" Margin="0,0,18,0"/>
                            <TextBlock x:Name="LoadNet" Text="NET 1.2 Tbps" FontFamily="{StaticResource CondensedFont}" FontSize="9"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右侧 550W 光学传感器 -->
            <Grid Grid.Column="2" Background="#161616">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="14,0">
                    <Grid>
                        <TextBlock Text="OPTICAL SENSOR // 550W" Style="{StaticResource HudLabel}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource RedBrush}" Margin="0,0,6,0"/>
                            <TextBlock Text="LIVE" FontFamily="{StaticResource CondensedFont}" FontSize="9" Foreground="{StaticResource RedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ctl:MossEye x:Name="SideEye" Grid.Row="1" Width="230" Height="230" HorizontalAlignment="Center" Margin="0,18,0,10"/>

                <StackPanel Grid.Row="2" Margin="18,0,18,12">
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="MOSS STATE" Style="{StaticResource HudLabel}"/>
                        <TextBlock x:Name="EyeStateText" Text="OBSERVING" FontFamily="{StaticResource CondensedFont}" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{StaticResource RedBrush}" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock x:Name="EyeStateSub" Text="PASSIVE OPTICAL TRACKING / 8192 QUBIT" FontFamily="{StaticResource CondensedFont}"
                               FontSize="8" Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,10"/>

                    <Border BorderBrush="#3A3A3A" BorderThickness="1" Background="#1A1A1A">
                        <StackPanel>
                            <Grid Height="24" Margin="10,0">
                                <TextBlock Text="APERTURE" Style="{StaticResource HudLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="EyeMetricFocus" Text="F/2.8" FontFamily="{StaticResource CondensedFont}" FontSize="10"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border BorderBrush="#3A3A3A" BorderThickness="0,1,0,0"/>
                            <Grid Height="24" Margin="10,0">
                                <TextBlock Text="CORE TEMP" Style="{StaticResource HudLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="EyeMetricTemp" Text="4.2 K" FontFamily="{StaticResource CondensedFont}" FontSize="10"
                                           Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <Border BorderBrush="#3A3A3A" BorderThickness="0,1,0,0"/>
                            <Grid Height="24" Margin="10,0">
                                <TextBlock Text="UPLINK" Style="{StaticResource HudLabel}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="EyeMetricUptime" Text="SECURE / 100%" FontFamily="{StaticResource CondensedFont}" FontSize="10"
                                           Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="3" Margin="18,4,18,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="EVENT LOG // 事件流" Style="{StaticResource HudLabel}" Margin="0,0,0,6"/>
                    <Border Grid.Row="1" BorderBrush="#3A3A3A" BorderThickness="1" Background="#141414" Padding="8,6">
                        <ctl:DataStream VerticalAlignment="Top"/>
                    </Border>
                </Grid>

                <StackPanel Grid.Row="4" Margin="18,0,18,16">
                    <TextBlock Text="QUICK COMMANDS // 快捷命令" Style="{StaticResource HudLabel}" Margin="0,0,0,6"/>
                    <Button x:Name="CmdKey" Content="KEY AUTH DEMO" Style="{StaticResource QuietBtn}" Height="30"
                            HorizontalContentAlignment="Left" Padding="10,0" Margin="0,0,0,6" Click="CmdKey_Click"/>
                    <Button x:Name="CmdReboot" Content="REBOOT 550W" Style="{StaticResource QuietBtn}" Height="30"
                            HorizontalContentAlignment="Left" Padding="10,0" Click="CmdReboot_Click"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 扫描线 + 暗角 -->
        <Rectangle Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0.22">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,4,3" ViewportUnits="Absolute" Stretch="None">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 4,0">
                            <GeometryDrawing.Pen>
                                <Pen Brush="#0AFFFFFF" Thickness="1"/>
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Grid.RowSpan="3" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.75">
                    <GradientStop Color="#00000000" Offset="0.55"/>
                    <GradientStop Color="#55000000" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
    </Viewbox>
</Window>
