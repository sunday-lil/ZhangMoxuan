<Window x:Class="ZhangMoxuan.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:ZhangMoxuan.Controls"
        Title="MOSS · 550W" Height="800" Width="1440"
        WindowStyle="None" WindowState="Maximized"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 导航按钮：左侧细条 indicator，无 ▸ 箭头，无红色铺底 -->
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Padding" Value="28,12,0,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="ActiveMark" Width="2" HorizontalAlignment="Left" Fill="{StaticResource RedBrush}" Opacity="0" RadiusX="1" RadiusY="1"/>
                            <Border x:Name="Bg" Background="Transparent"/>
                            <ContentPresenter Margin="28,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#10FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="ActiveMark" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 顶部次级按钮 -->
        <Style x:Key="QuietBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource SansFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#10FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="296"/>
        </Grid.ColumnDefinitions>

        <!-- ===== 左侧导航 ===== -->
        <Grid Grid.Column="0" Background="{StaticResource PanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- LOGO -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="28,0,0,0">
                <TextBlock Text="MOSS" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" TextOptions.TextRenderingMode="ClearType"/>
                <TextBlock Text="550W · SMART QUANTUM" FontFamily="{StaticResource MonoFont}" FontSize="9"
                           Foreground="{StaticResource TextTertiaryBrush}" Margin="0,4,0,0" Typography.Capitals="AllSmallCaps"/>
            </StackPanel>

            <!-- 导航菜单 -->
            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <TextBlock Text="MODULES" Style="{StaticResource HudLabel}" Margin="28,8,0,8"/>
                <Button x:Name="NavDashboard" Style="{StaticResource NavBtn}" Tag="Active" Click="Nav_Click" Content="Monitor"/>
                <Button x:Name="NavNetwork" Style="{StaticResource NavBtn}" Click="Nav_Click" Content="Network Topology"/>
                <Button x:Name="NavDigital" Style="{StaticResource NavBtn}" Click="Nav_Click" Content="Digital Life"/>
                <Button x:Name="NavCrisis" Style="{StaticResource NavBtn}" Click="Nav_Click" Content="Crisis Forecast"/>
                <Button x:Name="NavKey" Style="{StaticResource NavBtn}" Click="Nav_Click" Content="Key Auth"/>
                <Button x:Name="NavDialog" Style="{StaticResource NavBtn}" Click="Nav_Click" Content="Moss Dialog"/>
            </StackPanel>

            <!-- 底部 UEG 标识 -->
            <StackPanel Grid.Row="2" Margin="28,0,28,20">
                <Border BorderBrush="{StaticResource GridBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,14"/>
                <TextBlock Text="UNITED EARTH GOVERNMENT" FontFamily="{StaticResource SansFont}" FontSize="9"
                           Foreground="{StaticResource TextTertiaryBrush}" Typography.Capitals="AllSmallCaps"/>
                <TextBlock Text="Wandering Earth Project" FontFamily="{StaticResource SansFont}" FontSize="9"
                           Foreground="{StaticResource TextTertiaryBrush}" Margin="0,3,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource RedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SysStatus" Text="ONLINE" FontFamily="{StaticResource SansFont}" FontSize="9"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" Typography.Capitals="AllSmallCaps"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ===== 中央内容区 ===== -->
        <Grid Grid.Column="1" Background="{StaticResource BgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="36"/>
            </Grid.RowDefinitions>

            <!-- 顶部标题栏 -->
            <Border Grid.Row="0" BorderBrush="{StaticResource GridBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="36,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Monitor" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PageSub" Text="  ·  行星发动机网络 · 地球状态 · 量子核心" FontFamily="{StaticResource SansFont}"
                                   FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TopClock" Text="2075-01-01 00:00:00" FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="  ·  " Foreground="{StaticResource TextTertiaryBrush}"/>
                        <TextBlock Text="QV 8192" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource RedBrush}"/>
                        <Button x:Name="CloseBtn" Content="✕" Width="32" Height="32" Margin="16,0,0,0" Style="{StaticResource QuietBtn}"
                                FontSize="11" Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 页面容器 -->
            <Grid Grid.Row="1" x:Name="PageHost"/>

            <!-- 底部状态栏 -->
            <Border Grid.Row="2" BorderBrush="{StaticResource GridBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="36,0">
                    <TextBlock x:Name="BottomStatus" Text="MOSS · 延续人类文明的最优选择" FontFamily="{StaticResource SansFont}"
                               FontSize="10" Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="LoadCpu" Text="CPU 12%" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,20,0"/>
                        <TextBlock x:Name="LoadQubit" Text="QUBIT 8192/8192" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                   Foreground="{StaticResource RedBrush}" Margin="0,0,20,0"/>
                        <TextBlock x:Name="LoadNet" Text="NET 1.2Tbps" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 右侧 MOSS 之眼 ===== -->
        <Grid Grid.Column="2" Background="{StaticResource PanelBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center">
                <ctl:MossEye x:Name="SideEye" Width="180" Height="180" HorizontalAlignment="Center"/>
                <TextBlock Text="OBSERVING" FontFamily="{StaticResource SansFont}" FontSize="10"
                           Foreground="{StaticResource RedBrush}" HorizontalAlignment="Center" Margin="0,18,0,0"
                           Typography.Capitals="AllSmallCaps" FontWeight="SemiBold"/>
                <Border BorderBrush="{StaticResource GridBrush}" BorderThickness="0,1,0,0" Margin="28,24,28,0" Padding="0,16,0,0">
                    <ctl:DataStream Height="180"/>
                </Border>
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="{StaticResource GridBrush}" BorderThickness="0,1,0,0" Padding="28,14,28,18">
                <StackPanel>
                    <TextBlock Text="QUICK COMMANDS" Style="{StaticResource HudLabel}" Margin="0,0,0,10"/>
                    <Button x:Name="CmdReboot" Content="Reboot 550W" Style="{StaticResource NavBtn}" Padding="0,8,0,8" Click="CmdReboot_Click"/>
                    <Button x:Name="CmdKey" Content="Key Auth Demo" Style="{StaticResource NavBtn}" Padding="0,8,0,8" Click="CmdKey_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
