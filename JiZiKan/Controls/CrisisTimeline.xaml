<UserControl x:Class="JiZiKan.Controls.CrisisTimeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标签 -->
        <TextBlock Grid.Row="0"
                   Text="THREAT FORECAST // MOSS PREDICTION"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="11"
                   Foreground="{StaticResource RedBrush}"
                   Margin="4,0,0,6"/>

        <!-- 时间线画布 -->
        <Canvas Grid.Row="1"
                x:Name="TimelineCanvas"
                ClipToBounds="True"/>

        <!-- 详情区 -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource GridBrush}"
                BorderThickness="1"
                Padding="12,8"
                Margin="0,8,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <TextBlock x:Name="EventTitle"
                               Text="2075 // JUPITER GRAVITY CRISIS"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource RedBrightBrush}"/>
                    <TextBlock Text="[ MOSS PREDICTED ]"
                               HorizontalAlignment="Right"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="9"
                               Foreground="{StaticResource AmberBrush}"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,6">
                        <TextBlock Text="DESCRIPTION" Style="{StaticResource HudLabel}" Margin="0,0,0,3"/>
                        <TextBlock x:Name="DescText"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextWhiteBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,6">
                        <TextBlock Text="MOSS DECISION" Style="{StaticResource HudLabel}" Margin="0,0,0,3"/>
                        <TextBlock x:Name="DecisionText"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource AmberBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,6,10,0">
                        <TextBlock Text="CONFIDENCE" Style="{StaticResource HudLabel}" Margin="0,0,0,3"/>
                        <TextBlock x:Name="ConfText"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource RedBrightBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,6,0,0">
                        <TextBlock Text="CASUALTY EST." Style="{StaticResource HudLabel}" Margin="0,0,0,3"/>
                        <TextBlock x:Name="CasualtyText"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource RedBrightBrush}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- MOSS 语录滚动 -->
        <Border Grid.Row="3"
                BorderBrush="{StaticResource GridBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,6,0,0"
                Padding="0,5,0,5">
            <Canvas x:Name="QuoteCanvas"
                    ClipToBounds="True"
                    Height="18">
                <TextBlock x:Name="QuoteText"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{StaticResource TextBrush}"
                           Canvas.Left="0"
                           Canvas.Top="2">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="QuoteTransform"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Canvas>
        </Border>
    </Grid>
</UserControl>
