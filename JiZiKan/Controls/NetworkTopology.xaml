<UserControl x:Class="JiZiKan.Controls.NetworkTopology"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             Background="#050608">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标签栏 -->
        <Border Grid.Row="0" Background="#0A0C10" BorderBrush="#1A1F26" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="UEG BACKBONE // GLOBAL NETWORK TOPOLOGY"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="12"
                           Foreground="#FF1A1A"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           x:Name="ClockText"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="#9AA0A6"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 主画布区域：世界地图 + 节点 + 连线 + 数据包 -->
        <Canvas Grid.Row="1" x:Name="MapCanvas" ClipToBounds="True"/>

        <!-- 底部统计栏（右下角） -->
        <Border Grid.Row="2" Background="#0A0C10" BorderBrush="#1A1F26" BorderThickness="0,1,0,0" Padding="12,5">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="ONLINE " FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#9AA0A6" VerticalAlignment="Center"/>
                    <TextBlock x:Name="NodesStat" Text="0/0" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#FF1A1A" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="BW " FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#9AA0A6" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BandwidthStat" Text="0 Tbps" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#FF1A1A" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="LAT " FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#9AA0A6" VerticalAlignment="Center"/>
                    <TextBlock x:Name="LatencyStat" Text="0 ms" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="#FF1A1A" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
