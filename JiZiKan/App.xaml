<Application x:Class="JiZiKan.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnLastWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- MOSS 主题色：黑色背景 + 红色强调（电影中红色=MOSS/无约束能量） -->
            <Color x:Key="BgBlack">#050608</Color>
            <Color x:Key="BgPanel">#0A0C10</Color>
            <Color x:Key="GridLine">#1A1F26</Color>
            <Color x:Key="MossRed">#FF1A1A</Color>
            <Color x:Key="MossRedBright">#FF3838</Color>
            <Color x:Key="MossRedDim">#8A0F0F</Color>
            <Color x:Key="HumanBlue">#1E6FFF</Color>
            <Color x:Key="TextGray">#9AA0A6</Color>
            <Color x:Key="TextWhite">#E6E8EB</Color>
            <Color x:Key="WarnAmber">#FFB300</Color>

            <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgBlack}"/>
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource BgPanel}"/>
            <SolidColorBrush x:Key="GridBrush" Color="{StaticResource GridLine}"/>
            <SolidColorBrush x:Key="RedBrush" Color="{StaticResource MossRed}"/>
            <SolidColorBrush x:Key="RedBrightBrush" Color="{StaticResource MossRedBright}"/>
            <SolidColorBrush x:Key="RedDimBrush" Color="{StaticResource MossRedDim}"/>
            <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource HumanBlue}"/>
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextGray}"/>
            <SolidColorBrush x:Key="TextWhiteBrush" Color="{StaticResource TextWhite}"/>
            <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource WarnAmber}"/>

            <!-- 等宽字体（电影中数据流为单色等宽） -->
            <FontFamily x:Key="MonoFont">Consolas, Cascadia Mono, Courier New</FontFamily>
            <FontFamily x:Key="SansFont">Microsoft YaHei UI, Segoe UI</FontFamily>

            <!-- 全局控件样式 -->
            <Style x:Key="MossText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            </Style>

            <Style x:Key="HudLabel" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource RedBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource BgBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
                <Setter Property="TextOptions.TextRenderingMode" Value="Aliased"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
